CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=selene-r-oss-update
KERNEL_CONFIG=selene_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_ARCH=arm64
ENABLE_KERNELSU=true
KERNELSU_TAG=
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
KSU_REVERT=false
ADD_KPROBES_CONFIG=false
KSU_HOOKS_PATCH=true
ADD_OVERLAYFS_CONFIG=true
ADD_APATCH_SUPPORT=false
FIX_APATCH_OPENELA=false
OLD_ANDROID_SUPPORT=false
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_CUSTOM_GCC=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-gnu
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-gnueabihf
CLANG_BRANCH=main
CLANG_VERSION=r416183b1
ENABLE_GCC_AOSP=true
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS=CROSS_COMPILE=aarch64-linux-android- CROSS_COMPILE_ARM32=arm-linux-androideabi- CROSS_COMPILE_COMPAT=arm-linux-androideabi-
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
DISABLE_LTO=true
DISABLE_CC_WERROR=true
FIX_WIFI_SPEED=false
REMOVE_UNUSED_PACKAGES=false
ENABLE_CCACHE=true
ADD_LOCALVERSION_TO_FILENAME=false
